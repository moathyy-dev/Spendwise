# =========================================================
# SpendWise - ملف الإعدادات البيئية (مثال)
# انسخ هذا الملف باسم .env واملأ القيم الحقيقية فيه محليًا فقط.
# لا تقم أبدًا برفع ملف .env الفعلي إلى GitHub.
# =========================================================

# مزود الذكاء الاصطناعي: gemini أو none (بدون AI، الاعتماد على القواعد المحلية فقط)
SPENDWISE_AI_PROVIDER=gemini

# مفتاح Gemini API (احصل عليه مجانًا من https://aistudio.google.com)
GEMINI_API_KEY=

# اسم نموذج Gemini
GEMINI_MODEL=gemini-1.5-flash

# مهلة الاتصال بالثواني وعدد محاولات الإعادة
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2

# عتبة الثقة الدنيا لقبول تصنيف محلي بدون مراجعة (0-100)
CONFIDENCE_THRESHOLD_AUTO_ACCEPT=95
# عتبة الثقة الدنيا التي دونها يتم اللجوء إلى الذكاء الاصطناعي
CONFIDENCE_THRESHOLD_AI_FALLBACK=80

# العملة الأساسية الافتراضية
BASE_CURRENCY=SAR

# مسار قاعدة البيانات المحلية (SQLite)
DATABASE_PATH=./data/spendwise.db

# تفعيل/تعطيل الذكاء الاصطناعي عبر الإنترنت بشكل عام (true/false)
ENABLE_ONLINE_AI=true

# تفعيل جلب أسعار الصرف أونلاين (true/false) - إن كان false يُستخدم الإدخال اليدوي فقط
ENABLE_ONLINE_FX=false

# =========================================================
# الإعدادات التالية اختيارية بالكامل، ومخصصة فقط لحالة نشر
# SpendWise على رابط عام (مثل Streamlit Community Cloud).
# للاستخدام العادي على جهازك الشخصي اتركهما فارغين تمامًا.
# =========================================================

# رابط اتصال قاعدة بيانات سحابية (مثل Postgres من Neon.tech) بدل SQLite
# المحلي. إن تُرك فارغًا، يُستخدم SQLite المحلي عبر DATABASE_PATH كالمعتاد.
# مثال: postgresql://user:password@host/dbname
DATABASE_URL=

# كلمة مرور بسيطة لحماية التطبيق عند نشره على رابط عام يصل إليه أي شخص
# يعرف الرابط. إن تُرك فارغًا، لا تظهر أي شاشة دخول (الوضع الطبيعي للاستخدام
# المحلي على جهازك).
SPENDWISE_APP_PASSWORD=
